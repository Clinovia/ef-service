# .env.example
# Copy this file to .env and fill in your actual values

# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION=us-east-1

# S3 Configuration
CLINOVIA_S3_BUCKET=clinovia.ai
EF_MODEL_KEY=models/cardiology/ejection-fraction/v1/ef3dcnn_epoch17.pth

# Local Configuration
LOCAL_MODEL_PATH=/tmp/ef_model.pth
PORT=8081
MAX_VIDEO_SIZE_MB=100

# Development
USE_LOCAL_MODEL=false